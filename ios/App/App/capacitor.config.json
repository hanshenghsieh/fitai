{
	"appId": "app.fitai.betterbit",
	"appName": "Betterbit",
	"webDir": "out",
	"ios": {
		"contentInset": "never",
		"scrollEnabled": false,
		"allowsLinkPreview": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#FFF9F2",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#FFF9F2",
			"overlaysWebView": true
		}
	},
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"betterbit.app",
			"*.betterbit.app",
			"*.vercel.app"
		]
	},
	"packageClassList": [
		"AppPlugin",
		"CAPCameraPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"PurchasesPlugin"
	]
}
